rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Profile: displayName, email, photoURL, coverURL, timestamps (js/firebase.js, js/profile.js)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Bookmarked destinations (TT.saveDestination / getSavedDestinations)
      match /savedDestinations/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Saved trip budgets (TT.saveCalculation / getCalculations)
      match /calculations/{calcId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Destination catalogue is public, read-only; manage it from the Firebase console / Admin SDK.
    match /destinations/{destId} {
      allow read: if true;
      allow write: if false;

      // Reviews (js/destinations.js submitReview): anyone can read, signed-in users can
      // add a review as themselves; no edits or deletes from the client.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'rating', 'comment', 'timestamp'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 2000
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 100
          && request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
